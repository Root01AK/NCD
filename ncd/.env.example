# Coolify & VPS Database Configuration
# Copy this to .env or set these environment variables in Coolify Environment Variables settings:

DB_HOST=mysql (or internal Coolify host name)
DB_PORT=3306
DB_NAME=ncd
DB_USER=root
DB_PASSWORD=YourCoolifyDBPassword

# Alternatively, if Coolify provides a single connection string:
# DATABASE_URL=mysql://root:YourCoolifyDBPassword@mysql:3306/ncd

# Center-specific databases (optional - defaults to DB_NAME if not set)
DB_NAME_DHARAVI=ncd
DB_NAME_MALVANI=ncd
DB_NAME_VASHI=ncd
